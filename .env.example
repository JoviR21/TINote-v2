# Copy jadi .env terus isi
DJANGO_SECRET_KEY=ganti-dengan-random-aman
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Opsi 1 (gampang): URL pooler Supabase, contoh:
# DATABASE_URL=postgresql://postgres.USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Opsi 2: variabel terpisah
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.xxxxx
# SUPABASE_DB_PASSWORD=isi-password-supabase
# SUPABASE_DB_PORT=6543

# Kosongkan semua di atas = pakai sqlite lokal (db.sqlite3) buat dev
